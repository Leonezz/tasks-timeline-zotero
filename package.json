{
  "name": "tasks-timeline-zotero",
  "type": "module",
  "version": "0.2.1",
  "description": "Tasks Timeline for Zotero: plan reading and research tasks on a timeline",
  "config": {
    "addonName": "Tasks Timeline",
    "addonID": "tasks-timeline@zotero-plugin",
    "addonRef": "taskstimeline",
    "addonInstance": "TasksTimeline",
    "prefsPrefix": "extensions.zotero.taskstimeline"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonezz/tasks-timeline-zotero.git"
  },
  "author": "Leonezz",
  "bugs": {
    "url": "https://github.com/Leonezz/tasks-timeline-zotero/issues"
  },
  "homepage": "https://github.com/Leonezz/tasks-timeline-zotero#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "pnpm update",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@tasks-timeline/components": "^0.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "eslint": "^9.39.5",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "rrule": "2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
