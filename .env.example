# Copy to `.env` and fill in. Use a dedicated profile and data directory so
# development never touches your real Zotero library.

# macOS: /Applications/Zotero.app/Contents/MacOS/zotero (Zotero 10+)
ZOTERO_PLUGIN_ZOTERO_BIN_PATH = /path/to/zotero

# Created on first `pnpm start` if missing.
ZOTERO_PLUGIN_PROFILE_PATH = /abs/path/to/repo/.scaffold/profile
ZOTERO_PLUGIN_DATA_DIR = /abs/path/to/repo/.scaffold/data

# REQUIRED on macOS: the scaffold's default kill command is
# `kill -9 $(ps -x | grep zotero)`, which force-kills every Zotero process,
# including your everyday instance. Scope it to the dev profile instead
# (the [.] stops pkill from matching its own shell's command line).
ZOTERO_PLUGIN_KILL_COMMAND = pkill -9 -f "/abs/path/to/repo/[.]scaffold/profile"

# GitHub token for local releases (CI does not need this).
# GITHUB_TOKEN =
